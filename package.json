{
  "name": "ian-app",
  "version": "0.1.0",
  "homepage": "https://ianapp.vercel.app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "doctor": "node scripts/doctor.mjs",
    "help": "node scripts/help.mjs",
    "sync": "node scripts/sync.mjs",
    "publish": "node scripts/publish.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:docs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
