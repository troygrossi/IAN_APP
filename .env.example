# Copy this file to `.env.local` and fill it in.  (`npm run doctor -- --fix` copies it for you.)
# `.env.local` holds secrets and is never saved to git. This file has no secrets and is saved.
# Rule: every variable the code reads must have a line here. `npm run check` enforces it.

# --- App ---------------------------------------------------------------
# The address of the site. Leave as-is on your own computer.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase Postgres) ---------------------------------------
# The connection string for the database. Pages load without it, but nobody can
# sign in and nothing can be saved, because accounts live in the database.
# Where to get it: ONBOARDING.md step 11, or `npm run help -- 5`
DATABASE_URL=

# --- Live prices (Financial Modeling Prep) -------------------------------
# Your FMP API key, from financialmodelingprep.com > Dashboard. Optional: without it
# the app shows the price snapshot saved in src/lib/wheel/sample-data.ts.
FMP_API_KEY=

# --- Set by Vercel, never by you ------------------------------------------
# The id of the version Vercel is building. /api/health reports it.
# VERCEL_GIT_COMMIT_SHA=

# --- Payments (not connected yet — see docs/rules/PAYMENTS.md) -----------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
