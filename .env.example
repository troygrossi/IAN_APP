# Copy this file to `.env.local` and fill it in.  (`npm run doctor -- --fix` copies it for you.)
# `.env.local` holds secrets and is never saved to git. This file has no secrets and is saved.
# Rule: every variable the code reads must have a line here. `npm run check` enforces it.

# --- App ---------------------------------------------------------------
# The address of the site. Leave as-is on your own computer.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase Postgres) ---------------------------------------
# The connection string for the database. The app runs without it, but
# anything that saves data will say "database is not connected yet".
# Where to get it: `npm run help -- 5`
DATABASE_URL=

# --- Login (not connected yet — see docs/rules/AUTH.md) ------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Payments (not connected yet — see docs/rules/PAYMENTS.md) -----------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
